# GCP Configuration
PROJECT_ID="your-google-cloud-project-id"
LOCATION="us-central1"
STORAGE_BUCKET="gs://your-staging-bucket-name"

# Gemini Enterprise Integration
GEMINI_ENTERPRISE_APP_ID="your-gemini-enterprise-app-id"

# Okta OAuth Configuration
# obtained after creating the Discovery Engine Authorization Resource
OKTA_AUTH_ID="okta-auth"
AGENT_AUTHORIZATION="projects/your-gcp-project-number/locations/global/authorizations/okta-auth"

# Okta Application Details (obtained from Okta console)
OKTA_CLIENT_ID="your-okta-web-client-id"
OKTA_CLIENT_SECRET="your-okta-web-client-secret"
OKTA_DOMAIN="your-okta-org.okta.com"
OKTA_AUTH_SERVER_ID="default"

# Okta Endpoints
OKTA_AUTHORIZATION_URI="https://your-okta-org.okta.com/oauth2/default/v1/authorize"
OKTA_TOKEN_URI="https://your-okta-org.okta.com/oauth2/default/v1/token"
